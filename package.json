    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "nodemailer": "^10.6.1",
    "typescript": "^5"
