rules_version = '2';

// Guests have no account. A reservation's id is a random UUID the guest's browser makes and keeps (it goes in
// their personal link): knowing it is the proof of ownership. A gift has `quantity` units; each reservation holds
// some of them. On the public gift doc a reservation shows up only as holds[holdId] (another random id), and
// holdLocks/{holdId} — readable by nobody — maps that hold back to the secret token.
//
// Every guest write is a batch, and each document's rule checks the others with get() (state before) and
// getAfter() (state after). The gift doc names the hold being touched in `lastHold`, because rules can't pull
// the one changed key out of a map diff.
//   reserve  = create reservations/{token} + create holdLocks/{holdId} + gift: add holds[holdId], heldUnits += n
//   confirm  = reservations/{token} → bought   + gift: drop hold, heldUnits -= n, boughtUnits += n, givers += giver
//   give up  = reservations/{token} → released + gift: drop hold, heldUnits -= n
// Holds past 72h are cleared by scripts/mailer.mjs; until then their units still count as taken.
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in ['lEYtbTBbpfXaUdzz7sQq05Qz1c32', 'mVGO28Yprqcc7z60fCev1GdDlTo1'];
    }

    function giftPath(id) { return /databases/$(db)/documents/gifts/$(id); }
    function lockPath(id) { return /databases/$(db)/documents/holdLocks/$(id); }
    function resPath(t) { return /databases/$(db)/documents/reservations/$(t); }

    // Same list as TIERS in src/data/gifts.ts.
    function tiers() {
      return ['Amigo', 'Amiga', 'Família', 'Pai', 'Mãe', 'Irmão', 'Irmã', 'Avô', 'Avó',
              'Tio', 'Tia', 'Primo', 'Prima', 'Padrinho', 'Madrinha'];
    }

    match /gifts/{giftId} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // The holds map changed in exactly one key: the hold named in lastHold.
      function onlyHold(hid) {
        return request.resource.data.holds.diff(resource.data.holds).affectedKeys().hasOnly([hid]);
      }

      function guestReserve() {
        let before = resource.data;
        let after = request.resource.data;
        let hid = after.lastHold;
        let h = after.holds[hid];
        let res = getAfter(resPath(getAfter(lockPath(hid)).data.token)).data;
        return before.status == 'available'
          && before.get('locked', false) != true
          && changed().hasOnly(['holds', 'heldUnits', 'lastHold'])
          && hid is string && !before.holds.keys().hasAny([hid]) && onlyHold(hid)
          && h.keys().hasOnly(['units', 'reservedAt', 'giverName', 'giverTier'])
          && h.units is int && h.units >= 1
          && h.reservedAt == request.time
          && h.giverName is string && h.giverName.size() > 0 && h.giverName.size() <= 30
          && after.heldUnits == before.heldUnits + h.units
          && after.heldUnits + before.boughtUnits <= before.quantity
          && res.giftId == giftId && res.holdId == hid && res.units == h.units && res.tier == h.giverTier
          && res.status == 'reserved' && res.reservedAt == request.time;
      }

      // The lock is read as it was BEFORE the batch, so swapping it in the same batch doesn't help.
      function guestClose() {
        let before = resource.data;
        let after = request.resource.data;
        let hid = after.lastHold;
        let h = before.holds[hid];
        let tok = get(lockPath(hid)).data.token;
        let prev = get(resPath(tok)).data;
        let res = getAfter(resPath(tok)).data;
        let bought = before.boughtUnits + h.units;
        return before.holds.keys().hasAny([hid]) && !after.holds.keys().hasAny([hid]) && onlyHold(hid)
          && prev.status == 'reserved' && prev.holdId == hid && prev.giftId == giftId
          && after.heldUnits == before.heldUnits - h.units
          && (
            (res.status == 'bought'
              && changed().hasOnly(['holds', 'heldUnits', 'lastHold', 'boughtUnits', 'givers', 'status'])
              && after.boughtUnits == bought
              && after.givers == before.givers.concat([{ 'name': h.giverName, 'tier': h.giverTier, 'units': h.units }])
              && ((bought >= before.quantity && after.status == 'bought')
                  || (bought < before.quantity && after.status == before.status)))
            || (res.status == 'released' && changed().hasOnly(['holds', 'heldUnits', 'lastHold']))
          );
      }

      // 'reserved' is the old single-reservation status (no gift has it now); kept so a cached old page still loads.
      allow read: if isAdmin() || resource.data.status in ['available', 'reserved', 'bought'];
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || guestReserve() || guestClose();
    }

    // Who owns each hold. Nobody but admins can read it, so the token never leaks through a gift.
    match /holdLocks/{holdId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['token', 'giftId'])
        && request.resource.data.token is string
        && get(giftPath(request.resource.data.giftId)).data.status == 'available'
        && getAfter(giftPath(request.resource.data.giftId)).data.holds[holdId].reservedAt == request.time
        && getAfter(resPath(request.resource.data.token)).data.holdId == holdId
        && getAfter(resPath(request.resource.data.token)).data.giftId == request.resource.data.giftId
      );
    }

    match /reservations/{token} {
      function fields() {
        return ['giftId', 'holdId', 'units', 'name', 'email', 'tier', 'status', 'reservedAt', 'adminNotified'];
      }

      // The id is the secret: fetching by id is fine, listing is not.
      allow get: if true;
      allow list, delete: if isAdmin();

      allow create: if isAdmin() || (
        token.matches('^[0-9a-f-]{36}$')
        && request.resource.data.keys().hasOnly(fields())
        && request.resource.data.keys().hasAll(fields())
        && request.resource.data.giftId is string
        && request.resource.data.holdId is string
        && request.resource.data.units is int && request.resource.data.units >= 1
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.tier in tiers()
        && request.resource.data.status == 'reserved'
        && request.resource.data.reservedAt == request.time
        && request.resource.data.adminNotified == false
        && getAfter(lockPath(request.resource.data.holdId)).data.token == token
        && getAfter(giftPath(request.resource.data.giftId)).data.holds[request.resource.data.holdId].reservedAt == request.time
      );

      allow update: if isAdmin() || (
        resource.data.status == 'reserved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt'])
        && request.resource.data.status in ['bought', 'released']
        && request.resource.data.closedAt == request.time
        && get(lockPath(resource.data.holdId)).data.token == token
        && get(giftPath(resource.data.giftId)).data.holds.keys().hasAny([resource.data.holdId])
        && !getAfter(giftPath(resource.data.giftId)).data.holds.keys().hasAny([resource.data.holdId])
        && (request.resource.data.status == 'released'
            || getAfter(giftPath(resource.data.giftId)).data.boughtUnits
               == get(giftPath(resource.data.giftId)).data.boughtUnits + resource.data.units)
      );
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Couple-only data, e.g. how much each of us has saved for the down payment.
    match /private/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
